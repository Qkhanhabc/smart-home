PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/smarthome
MONGODB_TIMEOUT_MS=10000
PUBLIC_BASE_URL=http://localhost:3000

MQTT_HOST=r3c6ccbf.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=smarthome
MQTT_PASSWORD=fill-in-your-emqx-password
# AI provider. Ollama runs locally on the same computer as this backend.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=120000

# Optional: map confirmed physical rooms/labels without changing source code.
# Keep room null/absent until you have verified the wiring on the real model.
# DEVICE_LABELS_JSON={"led1":{"label":"Đèn phòng khách","room":"phòng khách","aliases":["đèn khách"]}}
# Optional PEM CA bundle path. Node.js system roots are used when unset.
# MQTT_CA_PATH=C:/path/to/emqxsl-ca.crt
